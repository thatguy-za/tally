# Path to the SQLite database file
DATABASE_PATH=./data/tally.sqlite
# Port the server listens on
PORT=3000
# Set to "false" to disable open registration after you have created your accounts
ALLOW_REGISTRATION=true
# Optional: an API key for Ask Tori and AI transaction categorisation. Set
# whichever provider you use — an admin picks the provider and model on the
# Server settings page, where the key can also be entered instead of here.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
